BootstrapOwner__Password=replace-with-a-strong-password
BootstrapOwner__CompanyCode=COMPANY-CODE
BootstrapOwner__CompanyName=Company Name
SystemAdmin__Email=owner@example.com
Email__Enabled=true
Email__Provider=Resend
Email__ApiBaseUrl=https://api.resend.com
Email__ApiKey=re_xxxxxxxxx
Email__Host=smtp.example.com
Email__Port=587
Email__Username=apikey-or-smtp-user
Email__Password=replace-with-smtp-password
Email__FromAddress=reports@example.com
Email__FromName=Pestneer Raporlama
Email__ReplyTo=support@example.com
Email__EnableSsl=true
Email__PublicBaseUrl=https://pesneer.onrender.com
Email__FrontendBaseUrl=https://pestneer-ctf.pages.dev
Email__GoogleClientId=000000000000-example.apps.googleusercontent.com
Email__GoogleClientSecret=replace-with-google-oauth-client-secret
Cors__AllowedOrigins__0=https://pestneer-ctf.pages.dev
SupabaseStorage__Enabled=false
SupabaseStorage__Url=https://YOUR_PROJECT_REF.supabase.co
